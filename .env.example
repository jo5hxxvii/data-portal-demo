# Copy to .env and adjust. All values below are demo defaults.

# Database connection (any SQLAlchemy URL). Default: local Postgres from docker-compose.yml
DATABASE_URL=postgresql+psycopg2://demo:demo@localhost:5432/demo_capital

# Synthetic data
FAKER_SEED=2026
NUM_CUSTOMERS=300
NUM_TRANSACTIONS=6000

# Demo logins (shown on the login page, fictional only)
DEMO_ADMIN_PASSWORD=admin-demo-1
DEMO_FINANCE_PASSWORD=finance-demo-1
DEMO_OPERATIONS_PASSWORD=ops-demo-1

# Business rules
LARGE_TXN_THRESHOLD=50000
DUPLICATE_WINDOW_MINUTES=10
RETRY_WINDOW_MINUTES=60
RECON_AMOUNT_TOLERANCE=0.01
